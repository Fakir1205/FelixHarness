# .env —— 本课程示例用通义千问（OpenAI 兼容接口）

# 模型
SYC_MODEL_NAME=qwen-max
SYC_MODEL_PROVIDER=openai
SYC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx# 在阿里云百炼平台申请
SYC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 连接弹性
SYC_MAX_RETRIES=12
SYC_TIMEOUT=60

# 持久化底座（与 3.4 的容器一致）
SYC_POSTGRES_URL=
SYC_REDIS_URL=

# 运行
SYC_LOG_LEVEL=INFO

# LangSmith 追踪配置
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=Felix-Project